# Copy to .env and fill in locally. Never commit real secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
VITE_CLOUD_HISTORY_ENABLED=false

# Neon PostgreSQL. Use only a least-privilege application role in hosted environments.
DATABASE_URL=

# Railway bucket / S3-compatible object storage (optional locally)
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=ams
